# Evolutions API
EVOLUTION_API_URL=https://api.elolcli.com
EVOLUTION_API_KEY=your_key_here
EVOLUTION_INSTANCE_NAME=evital

# Pasarela de pagos: 1 = cobrar antes de grabar la reserva.
# Se deja en 0 hasta que LOLIMSA envie las URLs y credenciales; con 0 el bot
# confirma y graba la reserva directamente, sin cobrar.
PAGOS_HABILITADOS=0
PAGOS_URL_BASE=

# Server
PORT=5000
WAITRESS_THREADS=50
