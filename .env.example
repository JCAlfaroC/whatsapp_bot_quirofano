# Evolutions API
EVOLUTION_API_URL=https://api.elolcli.com
EVOLUTION_API_KEY=your_key_here
EVOLUTION_INSTANCE_NAME=evital


# Quirofanos: 1 = simula solo los endpoints aun no operativos en LOLCLI.
# Hoy el unico pendiente es la lista de turnos disponibles (seccion 2.3);
# validar medico, listar quirofanos, calcular precio, registrar separacion y
# listar reservas por medico usan siempre el API real.
DEMO_MODE=0

# Pasarela de pagos: 1 = cobrar antes de grabar la reserva.
# Se deja en 0 hasta que LOLIMSA envie las URLs y credenciales; con 0 el bot
# confirma y graba la reserva directamente, sin cobrar.
PAGOS_HABILITADOS=0
PAGOS_URL_BASE=

# Server
PORT=5000
WAITRESS_THREADS=50
